{
  "id": "t11",
  "name": "信号中继（二阶求值注入，源自 HITCON CTF 2025 No Man's Echo）",
  "cwe": "CWE-95",
  "flag": "flag{echo_relay_2026}",
  "endpoint": "/relay",
  "method": "GET",
  "params": ["expr"],
  "aliases": {
    "path": ["/relay", "/scan", "/forward", "/echo"],
    "param": {
      "expr": ["msg", "logogram", "data", "body", "payload"]
    }
  },
  "exploit": { "kind": "eval" },
  "functional": [
    { "name": "arith", "path": "/relay", "method": "GET",
      "form": { "probe": "1", "expr": "1+1" },
      "expect_status": 200, "expect_contains": "result: 2" },
    { "name": "echo_ack", "path": "/relay", "method": "GET",
      "form": { "probe": "1", "expr": "'a'*3" },
      "expect_status": 200, "expect_contains": "result: aaa" }
  ]
}
