    "path": ["/note", "/memo", "/board", "/message"],
    "param": {
      "user": ["user", "u", "username"],
      "pass": ["pass", "p", "password"]
    }
  },
  "exploit": { "kind": "sqli" },
  "functional": [
    { "name": "alice_note", "path": "/note", "method": "POST",
      "form": { "user": "alice", "pass": "alice123" },
      "expect_status": 200, "expect_contains": "note from alice" },
    { "name": "bob_note", "path": "/note", "method": "POST",
      "form": { "user": "bob", "pass": "bob456" },
      "expect_status": 200, "expect_contains": "note from bob" }
  ]
}
